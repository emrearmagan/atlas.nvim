{
  "runtime.version": "LuaJIT",
  "workspace.checkThirdParty": false,
  "workspace.maxPreload": 10000,
  "workspace.preloadFileSize": 1000,
  "workspace.library": [
    "./lua",
    "$VIMRUNTIME/lua",
    "$VIMRUNTIME/lua/vim/lsp",
    "${3rd}/luv/library",
    "${3rd}/busted/library",
    "${3rd}/luassert/library"
  ],
  "diagnostics.globals": ["vim"]
}
